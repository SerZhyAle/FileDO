# Compiled binaries and executables
*.exe
*.dll
*.so
*.dylib

# ..but the distributable build output IS tracked: build.ps1 / `/build` refresh
# every variant here, and all of them must be committed (not just filedo.exe).
!exe_to_download/*.exe

# Go build artifacts
/filedo
/filedo.exe
/filedo_fill
/filedo_fill.exe

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace sum files
go.work.sum

# Generated PE resource objects (versioninfo + manifest)
*.syso
resource.syso

# Dependency directories (remove the comment below to include it)
# vendor/

# Visual Studio / VB.NET
.vs/
bin/
obj/
*.user
*.suo
*.cache
*.pdb
*.resources

# Runtime generated files
history.json
hash_cache.json
damaged_files.log
skip_files.list
# The good-files list `filedo check` writes into the current directory (SP-0030 REL-12).
check_files.list
*.tmp

# Test files created by FileDO
FILL_*_*.tmp
speedtest_*.txt
test_source*/
test_target*/
test_problematic*/
test_*_damaged/
test_*_rescue*/
test_*_safe/

# FileDO specific temporary directories
FileDO_Operations/

# System files
Thumbs.db
.DS_Store
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local config
.claude/

# Working documents - specs, plans, questionnaires, research notes. They stay on disk for the
# author and the agents and never enter git: the repository carries documentation of the
# finished product, not the thinking that produced it.
PLAN/

# Logs
*.log

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Local installer output (build.ps1 -Msi). The release workflow builds its own
# copy on the runner; nothing here is ever the artifact users get.
dist/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows shortcuts
*.lnk

# MSIX packaging (generated)
msix/stage/
msix/out/
msix/*.pfx
msix/*.cer
# The packaged Explorer command (SP-0020), built into the MSIX stage.
shellext/out/

# Secrets and signing material - pre-empt the leak, never catch it afterwards. Anywhere in
# the tree, not only msix\ (SP-0030 REL-01): release.ps1 refuses a dirty tree, and this is
# what keeps a key dropped at the root from being "dirty" in the first place.
*.pfx
*.p12
*.pem
*.key
*.snk
*.jks
*.keystore
.env
*token*
*secret*
# ..but not the vendored catalog glyphs and menu icons: `content.secret-file` is an ICON-SET id
# and a build input (SP-0049 AUD-18-F1). Re-include exactly these two folders' icon files.
!assets/glyphs/*.svg
!assets/menu-icons/*.ico
