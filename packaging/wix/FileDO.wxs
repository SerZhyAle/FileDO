<?xml version="1.0" encoding="UTF-8"?>
<!--
  The FileDO MSI.

  FileDO is a CLI at heart, but what it installs is a Windows program: the
  shell (filedo_win.exe) is what a shortcut opens, and the secret-file feature
  (FDSEC-FORMAT.md, SP-0005) only reaches the user through a document type and
  two Explorer verbs. So this installer does the four things a Windows program
  is expected to do, and each one is a feature the user can deselect:

    Main                 - the binaries, PATH, and two Start menu shortcuts:
                           FileDO and FileDO Disk Manager (the disks window)
    ExplorerIntegration  - the .fd-sec document type and the two verbs
    DiskContainerIntegration - the .fdd disk container type and its verbs
    DesktopShortcut      - the desktop icon

  Silent installs choose with ADDLOCAL, e.g.
      msiexec /i FileDO.msi /qn ADDLOCAL=Main,ExplorerIntegration,DiskContainerIntegration
      msiexec /i FileDO.msi /qn ADDLOCAL=Main              (no integration)

  The registry shape written by ExplorerIntegration is the SAME shape
  cmd\filedo\fdsec_register.go writes for the channels where no installer runs
  (portable zip, winget, go install). The two must not drift: the key names,
  the labels, the commands and the FileDO.RegisteredBy mark are one contract
  with two writers. This one writes HKLM and wins; the per-user writer stands
  down when it sees this.

  Build:
      wix build packaging\wix\FileDO.wxs -arch x64 -ext WixToolset.UI.wixext ^
        -d ProductVersion=... -d StageDir=... -d IconFile=... -d LicenseRtf=... -o FileDO.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- The document type id. It is an anchor in the same sense as the winget
       identifier: change it and every machine that ever installed FileDO keeps
       a dangling file type no uninstall will find. The same string is the
       fdsecProgID constant in cmd\filedo\fdsec_register.go. -->
  <?define ProgId = "FileDO.SecureContainer" ?>
  <!-- The .fdd disk container's document type (SP-0004 spec 5.8 item 6), an
       anchor of the same kind from the first shipped container. The same
       string is the vdProgID constant in cmd\filedo\vdisk_register_windows.go. -->
  <?define DiskProgId = "FileDO.DiskContainer" ?>

  <Package
      Name="FileDO"
      Manufacturer="Serhii Zhyhunenko"
      Version="$(var.ProductVersion)"
      UpgradeCode="4d6b3b1f-7c8e-4a25-9f1d-8e3b2c5a7d91"
      Scope="perMachine"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation Description="FileDO - Advanced File and Storage Operations Tool" />

    <!-- MigrateFeatures keeps the user's own feature choice across an upgrade.
         Without it, someone who deselected the Explorer integration would get
         it back at the next version, and someone who chose it would lose it. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of FileDO is already installed."
                  MigrateFeatures="yes" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="MainIcon" SourceFile="$(var.IconFile)" />
    <!-- The Disk Manager shortcut's own picture: the ICON-SET content.disk-container glyph
         on an accent plate (assets\menu-icons\app.disk-manager.ico, drawn by MenuIcons.vb),
         the one icon the window, its taskbar button and its Main window button show too.
         Read from the same staged icons\ folder the .fdd type's DefaultIcon file comes from,
         so no new define is asked of build.ps1 or release.yml. The generic mono
         content.disk-container.ico stays the .fdd file type's and the Explorer menu's. -->
    <Icon Id="DiskManagerIcon" SourceFile="$(var.StageDir)\icons\app.disk-manager.ico" />
    <Property Id="ARPPRODUCTICON" Value="MainIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/SerZhyAle/FileDO/issues" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/SerZhyAle/FileDO" />
    <Property Id="ARPCONTACT" Value="https://github.com/SerZhyAle" />
    <!-- The line Apps and features shows under the entry. The only place a
         person meets this program again is that list, months later. -->
    <Property Id="ARPCOMMENTS" Value="Storage speed and fake-capacity testing, readability checks, duplicate management, secure wipe, password-protected .fd-sec containers and .fdd virtual disks. Nothing sent over the internet, no telemetry." />
    <!-- Change and Repair are deliberately NOT suppressed: the features above
         are the reason. Turning the Explorer integration on or off later is
         "Change" in Apps and Features, and a repair is what puts the registry
         entries back if something else overwrites them. -->

    <!-- The feature tree UI. WixUI_FeatureTree is the stock dialog set whose
         Customize page IS the feature list, so the checkboxes come from the
         features below rather than from a hand-written dialog. -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <!-- The wizard's own artwork, regenerated from assets\icon.png by
         packaging\wix\make-art.ps1. Without these two, every page is the WiX
         default blue-and-white with no sign of what is being installed. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- Feature titles and descriptions are not decoration: the Customize page
         shows the description of whatever the person clicks, and it is the only
         place the installer can answer "what is this, and why would I want
         it?". Each one says what lands on the machine. -->
    <Feature Id="Main" Title="FileDO program" Level="1" Display="expand" AllowAbsent="no"
             Description="The program itself, into C:\Program Files\FileDO: the FileDO window, the filedo command line and its three companion tools (check, fill, test), and the helper scripts. Adds the folder to the system PATH so filedo works in any terminal, and puts FileDO and its Disk Manager in the Start menu. Required.">
      <ComponentGroupRef Id="FileDOFiles" />
      <ComponentRef Id="EnvPath" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DiskManagerShortcut" />

      <Feature Id="ExplorerIntegration" Title="Explorer right-click menu" Level="1" AllowAbsent="yes"
               Description="A 'File DO..' group in the right-click menu of any file: secure it into a password-protected .fd-sec container (keeping, deleting or wiping the original), unsecure one back, wipe a file, read-check it, and show its details. Plus the .fd-sec file type itself, with its own icon: a double-click is exactly the group's 'Unsecure and start' entry - a console asks for the password, restores the original into a folder only you and the system can read, hands it to whatever program it belongs to, and removes that copy when the console window closes. On Windows 11 the group is under 'Show more options'. Uninstalling removes it.">
        <ComponentGroupRef Id="ShellIntegration" />
      </Feature>

      <!-- SP-0004 spec 5.8 item 7: a feature of its own, not a part of
           ExplorerIntegration - it does not inherit that feature's release
           block (R9) and it does not tie a .fdd checkbox to the menu on every
           file. Same shape: selected by default, deselectable here and by
           ADDLOCAL, carried across upgrades by MigrateFeatures. -->
      <Feature Id="DiskContainerIntegration" Title="Disk container files (.fdd)" Level="1" AllowAbsent="yes"
               Description="The .fdd file type of FileDO's virtual disks, with its own icon: a double-click opens the FileDO window and mounts the container as a drive letter, and the right-click menu adds 'Mount read-only' and 'Unmount'. A container with a password asks for it in the window, never on a command line. Nothing is mounted until you click. On Windows 11 the two extra entries are under 'Show more options'. Uninstalling removes the file type; the containers themselves stay where they are.">
        <ComponentGroupRef Id="DiskContainerShell" />
      </Feature>

      <Feature Id="DesktopShortcut" Title="Desktop icon" Level="1" AllowAbsent="yes"
               Description="A FileDO icon on the desktop for every account on this computer. It opens the same window as the FileDO entry in the Start menu (the Disk Manager has its own entry there) - this is convenience, nothing else.">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FileDO">
        <Directory Id="MENUICONSFOLDER" Name="icons" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuDir" Name="FileDO" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

  </Package>

  <Fragment>
    <Component Id="EnvPath" Directory="INSTALLFOLDER" Guid="b9f47a02-2d5e-4f1c-90a3-1c6e8d7b4a2f">
      <Environment Id="UpdatePath"
                   Name="PATH"
                   Value="[INSTALLFOLDER]"
                   Permanent="no"
                   Part="last"
                   Action="set"
                   System="yes" />
      <RegistryValue Root="HKLM"
                     Key="Software\FileDO"
                     Name="InstallPath"
                     Type="string"
                     Value="[INSTALLFOLDER]"
                     KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="AppProgramMenuDir" Guid="7e1c9a44-2f8b-4d63-9a1e-5c6b8d2f4a30">
      <Shortcut Id="FileDOGuiShortcut"
                Name="FileDO"
                Description="FileDO - build and run any storage command"
                Target="[INSTALLFOLDER]filedo_win.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="MainIcon" />
      <RemoveFolder Id="RemoveAppProgramMenuDir" Directory="AppProgramMenuDir" On="uninstall" />
      <RegistryValue Root="HKLM"
                     Key="Software\FileDO"
                     Name="GuiShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- SP-0063: the Disk Manager window has its own Start menu entry. It is the same
       filedo_win.exe as the FileDO entry, started with its disks option (see the
       Arguments below), so there is no new executable. A component of its own with its own GUID (the StartMenuShortcut
       component above keeps its key path and GUID for the product's life), in Main
       and not in DiskContainerIntegration: the window is part of the program, and
       is there whether or not the .fdd file type was chosen. -->
  <Fragment>
    <Component Id="DiskManagerShortcut" Directory="AppProgramMenuDir" Guid="6d261312-d66c-4644-951f-1d9a87d3999c">
      <Shortcut Id="FileDODiskManagerShortcut"
                Name="FileDO Disk Manager"
                Description="FileDO - see and mount your virtual disks"
                Target="[INSTALLFOLDER]filedo_win.exe"
                Arguments="--disks"
                WorkingDirectory="INSTALLFOLDER"
                Icon="DiskManagerIcon" />
      <RegistryValue Root="HKLM"
                     Key="Software\FileDO"
                     Name="DiskManagerShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="3f5d8c21-6b04-4e97-8a52-0d7c9e1b4f63">
      <Shortcut Id="FileDODesktopShortcut"
                Name="FileDO"
                Description="FileDO - build and run any storage command"
                Target="[INSTALLFOLDER]filedo_win.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="MainIcon" />
      <RegistryValue Root="HKLM"
                     Key="Software\FileDO"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- ==================================================================
       Explorer integration. Two things and nothing else (SP-0005 9.1, as
       amended 2026-09-20): a cascading "File DO.." group on all files, and
       a document type for .fd-sec whose double-click is exactly the group's
       "Unsecure and start" entry (amended again 2026-09-22).
       The group carries the option set (del / wipe / rename) as entries,
       which is the owner's reversal of the earlier single-purpose shape:
       the dialog that was to carry them belongs to a GUI stage that has not
       shipped, and a menu entry that then asks the question in a console is
       not the same thing as choosing the operation before anything happens.

       This file and cmd/filedo/fdsec_register*.go write the SAME keys,
       labels and commands. A change to one is a change to both, in the same
       commit.

       ForceDeleteOnUninstall is what makes an uninstall leave no orphaned
       document type behind: the subkeys were created by this component, so
       this component takes them away.
       ================================================================== -->
  <Fragment>
    <ComponentGroup Id="ShellIntegration" Directory="INSTALLFOLDER">

      <Component Id="ShellDocumentType" Guid="c41a7e58-9d36-4b82-a0f5-2e6c8b31d947">
        <RegistryKey Root="HKLM" Key="Software\Classes\$(var.ProgId)" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="FileDO secure container" KeyPath="yes" />
          <RegistryValue Name="FriendlyTypeName" Type="string" Value="FileDO secure container" />
          <!-- The mark `filedo fdsec unregister` looks for. One contract, two
               writers: without it the CLI would refuse to touch these keys. -->
          <RegistryValue Name="FileDO.RegisteredBy" Type="string" Value="[INSTALLFOLDER]filedo.exe" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="[INSTALLFOLDER]icons\content.secret-file.ico" />
          <RegistryValue Key="shell" Type="string" Value="open" />
          <RegistryValue Key="shell\open" Type="string" Value="Unsecure and start with FileDO" />
          <RegistryValue Key="shell\open" Name="Icon" Type="string" Value="[INSTALLFOLDER]FileDO.ico" />
          <!-- The open verb answered a double-click with the GUI's reveal page
               until 2026-09-22 (SP-0005 9.4): a whole window - a target card,
               a parameters card, a plan card - opened waiting to be filled in,
               which is not what "double-click, type the password" promises.
               It is now exactly the "Unsecure and start" entry of the group
               below, on the CLI: one password prompt on the console, then the
               restored file is handed to its registered program. This value
               and cmd/filedo/fdsec_register.go's fdsecOpenCommand must not
               drift - see the note at the top of that file. -->
          <RegistryValue Key="shell\open\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]filedo.exe&quot; &quot;%1&quot; unsecure start --pause --no-history" />
          <!-- No second verb on the document type. Everything a container
               needs is in the "File DO.." group below, which is on every
               file and so on containers too; the extension's own job is the
               double-click (owner's decision, 2026-09-20). -->
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.fd-sec" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="$(var.ProgId)" />
        </RegistryKey>
      </Component>

      <!-- The cascading "File DO.." group on all files. This component
           replaces ShellSecureVerb, which wrote a single "Secure with FileDO"
           entry under a different key: a component's key path may never move,
           so the replacement is a new component with a new GUID rather than
           an edit of the old one. The major upgrade is scheduled
           afterInstallValidate, so the previous version - and the old key
           with it - is removed before this one is written.

           SubCommands as an EMPTY string is what turns the key into a
           sub-menu whose entries are the `shell` subkey below it. The entry
           key names are never shown; their leading numbers are the only thing
           that fixes the order, because the shell draws them in the order the
           registry keeps them, which is by name.

           The group key must NOT carry a (Default) value. With SubCommands
           present, a (Default) on the group makes the shell build the sub-menu
           empty: the arrow is drawn and nothing opens. MUIVerb alone carries
           the label, so it is the key path of this component.

           CommandFlags=32 is ECF_SEPARATORBEFORE: a line above the entry, so
           a destructive one never sits flush against the one above it.

           The pause flag on every command is not decoration. Explorer closes
           the console the moment the process ends, so without it "Info" and
           "Check" print their answer into a window that is already gone. -->
      <Component Id="ShellMenuGroup" Guid="eaac8342-aace-41e0-8e1e-ed6cc4726b47">
        <RegistryKey Root="HKLM" Key="Software\Classes\*\shell\FileDO" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="MUIVerb" Type="string" Value="File DO.." KeyPath="yes" />
          <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]FileDO.ico" />
          <RegistryValue Name="SubCommands" Type="string" Value="" />
          <!-- The mark `filedo fdsec unregister` looks for. One contract, two
               writers: without it the CLI would refuse to touch these keys. -->
          <RegistryValue Name="FileDO.RegisteredBy" Type="string" Value="[INSTALLFOLDER]filedo.exe" />

          <RegistryValue Key="shell\10Secure" Type="string" Value="Secure" />
          <RegistryValue Key="shell\10Secure" Name="MUIVerb" Type="string" Value="Secure" />
          <RegistryValue Key="shell\10Secure" Name="Icon" Type="string" Value="[INSTALLFOLDER]icons\action.secure.ico" />
          <RegistryValue Key="shell\10Secure" Name="MultiSelectModel" Type="string" Value="Player" />
          <RegistryValue Key="shell\10Secure\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]filedo.exe&quot; &quot;%1&quot; secure --pause --no-history" />

          <RegistryValue Key="shell\20SecureDel" Type="string" Value="Secure and delete original" />
          <RegistryValue Key="shell\20SecureDel" Name="MUIVerb" Type="string" Value="Secure and delete original" />
          <RegistryValue Key="shell\20SecureDel" Name="Icon" Type="string" Value="[INSTALLFOLDER]icons\action.secure.ico" />
          <RegistryValue Key="shell\20SecureDel" Name="MultiSelectModel" Type="string" Value="Player" />
          <RegistryValue Key="shell\20SecureDel\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]filedo.exe&quot; &quot;%1&quot; secure del -y --pause --no-history" />

          <RegistryValue Key="shell\30SecureWipe" Type="string" Value="Secure and wipe original" />
          <RegistryValue Key="shell\30SecureWipe" Name="MUIVerb" Type="string" Value="Secure and wipe original" />
          <RegistryValue Key="shell\30SecureWipe" Name="Icon" Type="string" Value="[INSTALLFOLDER]icons\action.secure.ico" />
          <RegistryValue Key="shell\30SecureWipe" Name="MultiSelectModel" Type="string" Value="Player" />
          <RegistryValue Key="shell\30SecureWipe\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]filedo.exe&quot; &quot;%1&quot; secure wipe --pause --no-history" />

          <RegistryValue Key="shell\40SecureRename" Type="string" Value="Secure with a random name" />
          <RegistryValue Key="shell\40SecureRename" Name="MUIVerb" Type="string" Value="Secure with a random name" />
          <RegistryValue Key="shell\40SecureRename" Name="Icon" Type="string" Value="[INSTALLFOLDER]icons\action.secure.ico" />
          <RegistryValue Key="shell\40SecureRename" Name="MultiSelectModel" Type="string" Value="Player" />
          <RegistryValue Key="shell\40SecureRename\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]filedo.exe&quot; &quot;%1&quot; secure rename --pause --no-history" />

          <RegistryValue Key="shell\50Unsecure" Type="string" Value="Unsecure" />
          <RegistryValue Key="shell\50Unsecure" Name="MUIVerb" Type="string" Value="Unsecure" />
          <RegistryValue Key="shell\50Unsecure" Name="Icon" Type="string" Value="[INSTALLFOLDER]icons\action.unsecure.ico" />
          <RegistryValue Key="shell\50Unsecure" Name="MultiSelectModel" Type="string" Value="Player" />
          <RegistryValue Key="shell\50Unsecure" Name="CommandFlags" Type="integer" Value="32" />
          <RegistryValue Key="shell\50Unsecure\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]filedo.exe&quot; &quot;%1&quot; unsecure --pause --no-history" />

          <RegistryValue Key="shell\60UnsecureDel" Type="string" Value="Unsecure and delete container" />
          <RegistryValue Key="shell\60UnsecureDel" Name="MUIVerb" Type="string" Value="Unsecure and delete container" />
          <RegistryValue Key="shell\60UnsecureDel" Name="Icon" Type="string" Value="[INSTALLFOLDER]icons\action.unsecure.ico" />
          <RegistryValue Key="shell\60UnsecureDel" Name="MultiSelectModel" Type="string" Value="Player" />
          <RegistryValue Key="shell\60UnsecureDel\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]filedo.exe&quot; &quot;%1&quot; unsecure del -y --pause --no-history" />

          <RegistryValue Key="shell\65UnsecureStart" Type="string" Value="Unsecure and start" />
          <RegistryValue Key="shell\65UnsecureStart" Name="MUIVerb" Type="string" Value="Unsecure and start" />
          <RegistryValue Key="shell\65UnsecureStart" Name="Icon" Type="string" Value="[INSTALLFOLDER]icons\action.unsecure.ico" />
          <RegistryValue Key="shell\65UnsecureStart" Name="MultiSelectModel" Type="string" Value="Player" />
          <RegistryValue Key="shell\65UnsecureStart\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]filedo.exe&quot; &quot;%1&quot; unsecure start --pause --no-history" />

          <RegistryValue Key="shell\70Wipe" Type="string" Value="Wipe this file" />
          <RegistryValue Key="shell\70Wipe" Name="MUIVerb" Type="string" Value="Wipe this file" />
          <RegistryValue Key="shell\70Wipe" Name="Icon" Type="string" Value="[INSTALLFOLDER]icons\action.wipe.ico" />
          <RegistryValue Key="shell\70Wipe" Name="MultiSelectModel" Type="string" Value="Player" />
          <RegistryValue Key="shell\70Wipe" Name="CommandFlags" Type="integer" Value="32" />
          <RegistryValue Key="shell\70Wipe\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]filedo.exe&quot; file &quot;%1&quot; wipe --pause --no-history" />

          <RegistryValue Key="shell\80Check" Type="string" Value="Check this file" />
          <RegistryValue Key="shell\80Check" Name="MUIVerb" Type="string" Value="Check this file" />
          <RegistryValue Key="shell\80Check" Name="Icon" Type="string" Value="[INSTALLFOLDER]icons\action.verify.ico" />
          <RegistryValue Key="shell\80Check" Name="MultiSelectModel" Type="string" Value="Player" />
          <RegistryValue Key="shell\80Check\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]filedo.exe&quot; check &quot;%1&quot; --pause --no-history" />

          <RegistryValue Key="shell\90Info" Type="string" Value="Info" />
          <RegistryValue Key="shell\90Info" Name="MUIVerb" Type="string" Value="Info" />
          <RegistryValue Key="shell\90Info" Name="Icon" Type="string" Value="[INSTALLFOLDER]icons\app.info.ico" />
          <RegistryValue Key="shell\90Info" Name="MultiSelectModel" Type="string" Value="Player" />
          <RegistryValue Key="shell\90Info\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]filedo.exe&quot; file &quot;%1&quot; info --pause --no-history" />
        </RegistryKey>
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ==================================================================
       The .fdd disk container type (SP-0004 spec 6.1-6.2, P6 section 4.1),
       the DiskContainerIntegration feature. Its own ProgId with its own icon,
       and three verbs on the type itself - there is no group on every file
       for them to live in (a deliberate divergence from the .fd-sec type,
       spec 6.1). All three open the WINDOW, not the console (spec 6.4, 5.8
       item 8, another deliberate divergence): the window asks the unclean
       question before attaching, asks for the credential out of band, and
       says what elevation it needs.

       This file and cmd/filedo/vdisk_register_windows.go write the SAME
       keys, labels and commands, held together value for value by
       TestRegistryParity_TheMSIAndVdRegisterWriteTheSameDiskContainerType.
       A change to one is a change to both, in the same commit.

       .fdd lists the type under OpenWithProgids as well as naming it the
       default, so FileDO stays in "Open with" when another program claims
       .fdd later (spec 6.2). ForceDeleteOnUninstall takes both keys away, so
       no .fdd is left pointing at a handler that is gone.
       ================================================================== -->
  <Fragment>
    <ComponentGroup Id="DiskContainerShell" Directory="INSTALLFOLDER">

      <Component Id="DiskContainerType" Guid="7b0dc3fb-5803-446d-9c7a-d65a6d56fb96">
        <RegistryKey Root="HKLM" Key="Software\Classes\$(var.DiskProgId)" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="FileDO disk container" KeyPath="yes" />
          <RegistryValue Name="FriendlyTypeName" Type="string" Value="FileDO disk container" />
          <!-- The mark `filedo vd unregister` looks for. -->
          <RegistryValue Name="FileDO.RegisteredBy" Type="string" Value="[INSTALLFOLDER]filedo.exe" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="[INSTALLFOLDER]icons\content.disk-container.ico" />
          <RegistryValue Key="shell" Type="string" Value="mount" />
          <RegistryValue Key="shell\mount" Name="MUIVerb" Type="string" Value="Mount with FileDO" />
          <RegistryValue Key="shell\mount\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]filedo_win.exe&quot; &quot;%1&quot;" />
          <RegistryValue Key="shell\mountro" Name="MUIVerb" Type="string" Value="Mount read-only" />
          <RegistryValue Key="shell\mountro\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]filedo_win.exe&quot; --mount-ro &quot;%1&quot;" />
          <!-- Always present (spec 6.1 as amended 2026-09-26): a classic verb
               cannot be shown conditionally; on a container that is not
               mounted the window says so. -->
          <RegistryValue Key="shell\unmount" Name="MUIVerb" Type="string" Value="Unmount" />
          <RegistryValue Key="shell\unmount\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]filedo_win.exe&quot; --unmount &quot;%1&quot;" />
        </RegistryKey>
      </Component>

      <Component Id="DiskContainerExtension" Guid="e903ea1f-e463-49c0-bb41-ae02480a9cd3">
        <RegistryKey Root="HKLM" Key="Software\Classes\.fdd" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="$(var.DiskProgId)" KeyPath="yes" />
          <RegistryValue Key="OpenWithProgids" Name="$(var.DiskProgId)" Type="string" Value="" />
        </RegistryKey>
      </Component>

    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="FileDOFiles" Directory="INSTALLFOLDER">
      <Component Id="FileDOExe" Guid="*">
        <File Source="$(var.StageDir)\filedo.exe" KeyPath="yes" />
      </Component>
      <Component Id="FileDOWinExe" Guid="*">
        <File Source="$(var.StageDir)\filedo_win.exe" KeyPath="yes" />
      </Component>
      <!-- The GUI's app.config. It is not optional decoration: the manifest inside the exe makes
           the process per-monitor DPI aware, and this file is what makes WinForms rescale its
           controls to match. An install that carries one without the other renders worse than one
           that carries neither (SP-0006 M0). -->
      <Component Id="FileDOWinExeConfig" Guid="*">
        <File Source="$(var.StageDir)\filedo_win.exe.config" KeyPath="yes" />
      </Component>
      <!-- The document type's icon has to be a file on disk, not the icon
           embedded in the MSI: DefaultIcon is a path the shell reads at draw
           time, long after the installer is gone. -->
      <Component Id="FileDOIconFile" Guid="*">
        <File Source="$(var.StageDir)\FileDO.ico" KeyPath="yes" />
      </Component>
      <!-- The Explorer entries' and the document type's icons (SP-0016 T8): each its ICON-SET
           meaning's glyph, drawn by filedo_win.exe from the vocabulary (assets\menu-icons). The
           product mark stays on the group entry and the open verb only (ICON-SET rule 7). -->
      <Component Id="MenuIconSecure" Directory="MENUICONSFOLDER" Guid="*">
        <File Source="$(var.StageDir)\icons\action.secure.ico" KeyPath="yes" />
      </Component>
      <Component Id="MenuIconUnsecure" Directory="MENUICONSFOLDER" Guid="*">
        <File Source="$(var.StageDir)\icons\action.unsecure.ico" KeyPath="yes" />
      </Component>
      <Component Id="MenuIconWipe" Directory="MENUICONSFOLDER" Guid="*">
        <File Source="$(var.StageDir)\icons\action.wipe.ico" KeyPath="yes" />
      </Component>
      <Component Id="MenuIconVerify" Directory="MENUICONSFOLDER" Guid="*">
        <File Source="$(var.StageDir)\icons\action.verify.ico" KeyPath="yes" />
      </Component>
      <Component Id="MenuIconInfo" Directory="MENUICONSFOLDER" Guid="*">
        <File Source="$(var.StageDir)\icons\app.info.ico" KeyPath="yes" />
      </Component>
      <Component Id="MenuIconSecretFile" Directory="MENUICONSFOLDER" Guid="*">
        <File Source="$(var.StageDir)\icons\content.secret-file.ico" KeyPath="yes" />
      </Component>
      <!-- The .fdd type's icon (ICON-SET content.disk-container). In Main, not in
           DiskContainerIntegration, like the .fd-sec type's: `filedo vd register`
           run from this folder reads it too, whichever features were chosen. -->
      <Component Id="MenuIconDiskContainer" Directory="MENUICONSFOLDER" Guid="*">
        <File Source="$(var.StageDir)\icons\content.disk-container.ico" KeyPath="yes" />
      </Component>
      <Component Id="FileDOCheckExe" Guid="*">
        <File Source="$(var.StageDir)\filedo_check.exe" KeyPath="yes" />
      </Component>
      <Component Id="FileDOFillExe" Guid="*">
        <File Source="$(var.StageDir)\filedo_fill.exe" KeyPath="yes" />
      </Component>
      <Component Id="FileDOTestExe" Guid="*">
        <File Source="$(var.StageDir)\filedo_test.exe" KeyPath="yes" />
      </Component>
      <Component Id="FileDOCdBat" Guid="*">
        <File Source="$(var.StageDir)\filedo_cd.bat" KeyPath="yes" />
      </Component>
      <Component Id="FileDOCleanBat" Guid="*">
        <File Source="$(var.StageDir)\filedo_clean.bat" KeyPath="yes" />
      </Component>
      <Component Id="FileDOFillBat" Guid="*">
        <File Source="$(var.StageDir)\filedo_fill.bat" KeyPath="yes" />
      </Component>
      <Component Id="FileDOSpeedBat" Guid="*">
        <File Source="$(var.StageDir)\filedo_speed.bat" KeyPath="yes" />
      </Component>
      <Component Id="FileDOTestBat" Guid="*">
        <File Source="$(var.StageDir)\filedo_test.bat" KeyPath="yes" />
      </Component>
      <Component Id="LicenseFile" Guid="*">
        <File Source="$(var.StageDir)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyNoticesFile" Guid="*">
        <File Source="$(var.StageDir)\THIRD-PARTY-NOTICES.txt" KeyPath="yes" />
      </Component>
      <Component Id="ReadmeFile" Guid="*">
        <File Source="$(var.StageDir)\README.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
