<?xml version="1.0" encoding="UTF-8"?>
<!--
  The FileDO setup EXE (a WiX Burn bundle).

  This is the single file a person downloads and double-clicks:
  FileDO-<version>-setup.exe. It carries the MSI inside itself and hands the
  install over to it, so everything the package does - the binaries, PATH, the
  Start menu entry, the desktop icon and the Explorer integration - is decided
  by packaging\wix\FileDO.wxs and nothing is defined twice.

  Why a bundle at all, when the MSI already installs everything: an .exe is
  what people expect to download, it survives a browser that mangles .msi
  downloads, it upgrades a previous FileDO in one step, and it is the only
  place a prerequisite could later be chained in without touching the MSI.

  The UI is the MSI's own wizard, feature tree included. The bootstrapper is
  WixInternalUIBootstrapperApplication, whose whole job is to show the primary
  MSI's internal UI and draw no wizard of its own - two license pages and two
  progress bars for one install is worse than one of each.

  Change is the same wizard again (SP-0030 PKG-02). DisableModify="button"
  gives the one Apps-and-features entry a single Uninstall/Change action that
  starts this bundle in maintenance mode, and this bootstrapper then runs the
  MSI with its full UI whatever its state - so an installed FileDO opens the
  MSI's maintenance page: Change (the feature tree - the Explorer integration
  and the desktop icon on or off), Repair, Remove. The standard bootstrapper
  used before planned nothing for an MSI already present, so a Change there
  would have shown nothing at all; that is why DisableModify was "yes" until
  this.

  Build (build.ps1 -Msi does this after the MSI):
      wix build packaging\wix\FileDO-bundle.wxs -arch x64 ^
        -ext WixToolset.BootstrapperApplications.wixext ^
        -d ProductVersion=... -d MsiFile=... -d IconFile=... -d LicenseRtf=... ^
        -o dist\FileDO-<version>-setup.exe
  ProductVersion is the installer version yy.M.<minute of the month> that the
  MSI carries too (build.ps1 Get-InstallerVersion, PKG-01); LicenseRtf is
  accepted and unused here, the MSI shows the license.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <Bundle
      Name="FileDO"
      Manufacturer="Serhii Zhyhunenko"
      Version="$(var.ProductVersion)"
      UpgradeCode="033d2348-b26c-477f-8885-c68d9cfff47f"
      IconSourceFile="$(var.IconFile)"
      AboutUrl="https://github.com/SerZhyAle/FileDO"
      HelpUrl="https://github.com/SerZhyAle/FileDO/issues"
      UpdateUrl="https://github.com/SerZhyAle/FileDO/releases/latest"
      Compressed="yes"
      DisableModify="button">

    <!-- A bundle's UpgradeCode is its identity, exactly like the MSI's: the
         value below is how every future setup EXE recognises the one already
         installed and replaces it instead of adding a second entry to Apps and
         features. It is frozen for the product's life. It is NOT the MSI's
         UpgradeCode - two different installers, two different identities. -->
    <BootstrapperApplication>
      <!-- The license page is the MSI's own (WixUI_FeatureTree shows License.rtf),
           so this bootstrapper takes no LicenseFile: one license page, not two. -->
      <bal:WixInternalUIBootstrapperApplication />
    </BootstrapperApplication>

    <Chain>
      <!-- Vital: if the MSI fails, the bundle fails - there is nothing else in
           the chain that could be called a partial success.
           PrimaryPackageType="default": the one package whose internal UI the
           bootstrapper shows, on install and on Change alike - the feature
           checkboxes (Explorer integration, desktop shortcut) are that UI. -->
      <MsiPackage
          Id="FileDOMsi"
          SourceFile="$(var.MsiFile)"
          Vital="yes"
          Compressed="yes"
          bal:PrimaryPackageType="default" />
    </Chain>

  </Bundle>

</Wix>
