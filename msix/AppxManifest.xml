<?xml version="1.0" encoding="utf-8"?>
<!--
  FileDO MSIX package manifest (TEMPLATE).
  build-msix.ps1 fills the {{PLACEHOLDERS}} and writes the final manifest into stage\.
  Do not edit the staged copy by hand; edit this template.

  Identity/Name, Publisher, PublisherDisplayName come from Partner Center
  (Product > Product identity). Version is computed by the build script
  (Major.Minor.Build.0, revision must be 0, each part <= 65535).

  Two applications ship in one package:
    * FileDOGui - the clickable Start-menu tile (filedo_win.exe), a GUI that
      builds any filedo command and runs it.
    * FileDO    - the console tool (filedo.exe), hidden from the app list
      (AppListEntry="none") and exposed on PATH via an appExecutionAlias so
      `filedo` works from any terminal.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>FileDO</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Advanced tool for file and storage operations: storage speed testing, fake-capacity detection, secure wiping, and duplicate management. Ships a command-line tool plus a GUI command builder.</Description>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <!-- Clickable GUI tile: builds and runs any filedo command. -->
    <Application Id="FileDOGui" Executable="filedo_win.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="FileDO"
        Description="FileDO - build and run any storage command"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
    </Application>

    <!-- Console tool: hidden from the app list, exposed on PATH as `filedo`. -->
    <Application Id="FileDO" Executable="filedo.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="FileDO CLI"
        Description="Advanced File and Storage Operations Tool (command line)"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Makes `filedo` runnable from any terminal after install (PATH alias). -->
        <uap3:Extension Category="windows.appExecutionAlias">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="filedo.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
