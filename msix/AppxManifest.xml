<?xml version="1.0" encoding="utf-8"?>
<!--
  FileDO MSIX package manifest (TEMPLATE).
  build-msix.ps1 fills the double-brace placeholders and writes the final manifest into stage\.
  Do not edit the staged copy by hand; edit this template.

  Identity/Name, Publisher, PublisherDisplayName come from Partner Center
  (Product > Product identity). Version is computed by the build script
  (Major.Minor.Build.0, revision must be 0, each part <= 65535).

  Two applications ship in one package:
    * FileDOGui - the Start-menu tile (filedo_win.exe), the graphical shell.
    * FileDO    - the console tool (filedo.exe), exposed on PATH through an
                  appExecutionAlias so `filedo` works from any terminal.

  The CLI application is VISIBLE (no AppListEntry="none") on purpose. The Microsoft
  Store rejects a hidden app at package upload ("The package specifies a headless
  app. You don't have permission to create a headless app" - it needs a
  HeadlessAppBypass waiver); the sibling doc-html-translate hit exactly that with
  the same account. `build-msix.ps1 -Cli hidden` builds the hidden shape for an
  account that holds the waiver, `-Cli none` drops the CLI application, and the
  Store's own verdict at upload is the arbiter.

  MinVersion is 10.0.18362.0 (Windows 10 1903), not 1809: filedo_win.exe targets
  .NET Framework 4.8, which is in the box from 1903 on, and a package cannot
  declare a .NET Framework dependency. Declaring 1809 would offer the Store copy
  to machines where the graphical shell cannot start.

  The Store build cannot write the classic `HKCU\Software\Classes` context-menu
  keys (they are virtualized into the package), so its "File DO.." group is the
  packaged Explorer command of SP-0020: FileDOShell.dll, an IExplorerCommand
  declared below through desktop4:FileExplorerContextMenus and hosted by a COM
  surrogate (com:SurrogateServer), so a fault in it ends a dllhost.exe and not
  Explorer. That is what reaches the Windows 11 first-level menu. It also
  declares the `.fd-sec` file type, so Windows starts the GUI with a selected
  container's path on double-click.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop desktop4 desktop5 com rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>FileDO</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Storage speed tests, fake-capacity detection, secure wiping, duplicate management and password-protected secret files - a command-line tool with a graphical shell.</Description>
  </Properties>

  <Resources>
    <!-- One entry per interface language the GUI ships (Localization.vb), in Store locale
         tags. A locale absent here is a locale the Store will not offer the listing in,
         however well the app speaks it. Keep in step with msix/listing/*.txt. -->
    <Resource Language="en-us" />
    <Resource Language="ru" />
    <Resource Language="uk" />
    <Resource Language="de" />
    <Resource Language="fr" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <!-- The graphical shell: speed / capacity / wipe / duplicates / secret files. -->
    <Application Id="FileDOGui" Executable="filedo_win.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="FileDO"
        Description="FileDO - storage tests, secure wipe, duplicates and secret files"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- SP-0005 9.2: the .fd-sec association. Its logo is the ICON-SET meaning
             content.secret-file, not the product mark (SP-0016 T8). -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="filedo.securecontainer">
            <uap:Logo>Assets\SecretFile.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.fd-sec</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- SP-0020: the "File DO.." group at the Windows 11 first level, on every file
             (Type="*", as the classic `*\shell\FileDO`). The Clsid is the handler's one
             identity and appears twice - here and on the COM class - and in FileDOShell.cpp;
             build-msix.ps1 checks that all three agree. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="FileDO" Clsid="7B369FE8-B2BC-41EA-AA71-5427ACAD6E8E" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="FileDO Explorer command">
              <com:Class Id="7B369FE8-B2BC-41EA-AA71-5427ACAD6E8E" Path="FileDOShell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>

    <!-- The console tool, on PATH as `filedo`. Visible by default - see the header. -->
    <Application Id="FileDO" Executable="filedo.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="FileDO CLI"
        Description="FileDO command line - type filedo in any terminal"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Makes `filedo` runnable from any terminal after install (PATH alias). -->
        <uap3:Extension Category="windows.appExecutionAlias">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="filedo.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
