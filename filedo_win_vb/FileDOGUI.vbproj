<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{12345678-1234-5678-9012-123456789012}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <StartupObject>FileDOGUI.Program</StartupObject>
    <RootNamespace>FileDOGUI</RootNamespace>
    <AssemblyName>filedo_win</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <BuildStamp Condition="'$(BuildStamp)' == ''">dev</BuildStamp>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.0.0.0</AssemblyVersion>
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
    <!-- The DPI declaration of SP-0006 M0: the manifest makes the process per-monitor aware and
         app.config is what makes WinForms act on it. Both must ship; neither works alone. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <OutputPath>bin\Debug\</OutputPath>
    <DocumentationFile>FileDOGUI.xml</DocumentationFile>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42020,42021,42022</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DocumentationFile>FileDOGUI.xml</DocumentationFile>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42020,42021,42022</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)BuildVersion.vb" />
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Deployment" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Windows.Forms" />
    <Import Include="System.Linq" />
    <Import Include="System.Xml.Linq" />
    <Import Include="System.Threading.Tasks" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AppIcon.vb" />
    <Compile Include="ArgQuoting.vb" />
    <Compile Include="Ui.vb" />
    <Compile Include="Links.vb" />
    <Compile Include="AboutView.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Include="SettingsView.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Include="ArgQuotingTests.vb" />
    <Compile Include="EventStream.vb" />
    <Compile Include="Runner.vb" />
    <Compile Include="JobCatalogue.vb" />
    <Compile Include="SelfTest.vb" />
    <Compile Include="CheckOptions.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Include="JobView.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Include="HistoryView.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Include="CommandView.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Include="Theme.vb" />
    <Compile Include="Chrome.vb" />
    <Compile Include="ShellSettings.vb" />
    <Compile Include="Rail.vb" />
    <Compile Include="ShellForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Localization.vb" />
    <Compile Include="LogReport.vb" />
    <Compile Include="LogSender.vb" />
    <Compile Include="ShellLog.vb" />
    <Compile Include="ShellDialog.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="WindowPlacement.vb" />
    <Compile Include="WipeSafety.vb" />
    <Compile Include="Program.vb" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same icon ApplicationIcon stamps on the exe, embedded so the windows can use it too. -->
    <EmbeddedResource Include="..\assets\icon.ico">
      <Link>icon.ico</Link>
      <LogicalName>FileDOGUI.icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\cmd\filedo\testdata\events\sample-v1.jsonl">
      <Link>testdata\events\sample-v1.jsonl</Link>
      <LogicalName>FileDOGUI.events.sample-v1.jsonl</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
  <Target Name="WriteBuildVersion" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildVersion.vb" Overwrite="true"
      Lines="&lt;Assembly: System.Reflection.AssemblyVersion(&quot;$(AssemblyVersion)&quot;)&gt;&#xD;&#xA;&lt;Assembly: System.Reflection.AssemblyFileVersion(&quot;$(AssemblyVersion)&quot;)&gt;&#xD;&#xA;Namespace FileDOGUI&#xD;&#xA;    Friend Module BuildVersion&#xD;&#xA;        Friend Const Stamp As String = &quot;$(BuildStamp)&quot;&#xD;&#xA;    End Module&#xD;&#xA;End Namespace" />
  </Target>
</Project>
