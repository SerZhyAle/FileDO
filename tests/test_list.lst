# FileDO Comprehensive Test Suite
# This file contains tests for all major functionalities of FileDO
# Created: July 11, 2025
#
# Do not run this file directly. Its lines fill, clean, wipe and scan what they
# name, so they name placeholders - <TARGET_DRIVE> and <TARGET_DIR> - which no
# file operation can open, and the runner fills them in from FILEDO_TEST_TARGET after
# refusing anything that is not a mounted VHD or a folder under %TEMP%:
#   $env:FILEDO_TEST_TARGET = 'V:'
#   pwsh -File tests\run-test-list.ps1 -List tests\test_list.lst
# =====================================================================

# =====================================================================
# SECTION 1: DEVICE OPERATIONS
# =====================================================================

# Device Information
device <TARGET_DRIVE> info
device <TARGET_DRIVE> short
# Non-existent device (should handle gracefully)
device Z: info

device <TARGET_DRIVE> clean

# Device Speed Testing
device <TARGET_DRIVE> speed 10 short
device <TARGET_DRIVE> speed 50 nodel
device <TARGET_DRIVE> clean

# Device Test (Fake Capacity Detection)
# Test with small size for quick testing, normally would use full capacity
device <TARGET_DRIVE> test del

# Device Fill Operations
device <TARGET_DRIVE> fill 10
device <TARGET_DRIVE> clean
device <TARGET_DRIVE> fill 20 del

# Device Duplicate Detection
# First create some test duplicates
folder <TARGET_DIR>\TestDuplicates info
device <TARGET_DRIVE> cd short
device <TARGET_DRIVE> cd list <TARGET_DIR>\TestDuplicates\duplicates.lst

# =====================================================================
# SECTION 2: FOLDER OPERATIONS
# =====================================================================

# Folder Information
folder <TARGET_DIR>\TestFolder info
folder <TARGET_DIR>\TestFolder short
# Non-existent folder (should handle gracefully)
folder <TARGET_DIR>\NonExistentFolder info

folder <TARGET_DIR>\TestFolder clean

# Folder Speed Testing
folder <TARGET_DIR>\TestFolder speed 10 short
folder <TARGET_DIR>\TestFolder speed 20 nodel
folder <TARGET_DIR>\TestFolder clean

# Folder Test (Capacity)
folder <TARGET_DIR>\TestFolder test short
folder <TARGET_DIR>\TestFolder clean

# Folder Fill Operations
folder <TARGET_DIR>\TestFolder fill 10
folder <TARGET_DIR>\TestFolder clean
folder <TARGET_DIR>\TestFolder fill 20 del

# Folder Duplicate Detection
folder <TARGET_DIR>\TestFolder cd short
folder <TARGET_DIR>\TestFolder cd list <TARGET_DIR>\TestFolder\folder_duplicates.lst

# =====================================================================
# SECTION 3: FILE OPERATIONS
# =====================================================================

# File Information (First create a test file)
file <TARGET_DIR>\TestFolder\testfile.txt info
file <TARGET_DIR>\TestFolder\testfile.txt short
# Non-existent file (should handle gracefully)
file <TARGET_DIR>\TestFolder\nonexistent.txt info

# =====================================================================
# SECTION 4: NETWORK OPERATIONS (if available)
# =====================================================================

# Comment out if network share not available
# Replace with valid network path if testing network operations
network \\localhost\share info
network \\localhost\share short
network \\localhost\share clean
network \\localhost\share speed 10 short
network \\localhost\share test short
network \\localhost\share clean
network \\localhost\share fill 10 del
network \\localhost\share cd short
network \\localhost\share clean

# Non-existent network path (should handle gracefully)
network \\nonexistent\share info

# =====================================================================
# SECTION 5: DUPLICATE FILE MANAGEMENT
# =====================================================================

# Process duplicates with different selection modes and actions
# Test with the previously saved list files
folder test_dups cd list .\test_dups\duplicates.lst
cd from list .\test_dups\duplicates.lst old
cd from list .\test_dups\duplicates.lst new

# Non-existent list file (should handle gracefully)
cd from list .\test_dups\duplicates.lst

# =====================================================================
# SECTION 6: HISTORY & INFORMATION
# =====================================================================

# View history of operations
hist

# =====================================================================
# SECTION 7: CLEANUP
# =====================================================================

# Final cleanup
device <TARGET_DRIVE> clean
folder <TARGET_DIR>\TestFolder clean
network \\localhost\share clean

# =====================================================================
# SECTION 8: COPY & WIPE
# =====================================================================

# Copy
folder .\test_dups copy .\test_target2

# Wipe folder contents (fast deletion)
folder .\test_target2 wipe
folder .\test_wipe_folder w

# Wipe one file: overwritten in place and removed, never the folder meaning.
# The target is a throwaway copy on purpose - this line destroys what it names.
# Without an answer on stdin the prompt is refused and the file survives, which
# is itself the thing worth seeing: a batch run must not be able to wipe by
# accident.
file <TARGET_DIR>\TestFolder\testfile.txt wipe

# =====================================================================
# End of test suite
# =====================================================================
