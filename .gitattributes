# Vendored contract artifacts are held byte for byte to the SHA-256 in their PROVENANCE.txt, and the
# shell refuses a glyph whose hash does not match (filedo_win_vb/Glyphs.vb). An end-of-line conversion
# on checkout - core.autocrlf, on a developer machine or on the release runner - would change every
# hash, so these files are never converted (assets/sync-icon-glyphs.ps1).
assets/glyphs/** -text

# The fdsec conformance vectors are held to their PROVENANCE.txt the same way (TestVectors_Suite1/2/3).
fdsec/testdata/vectors/** -text
# Disk-container vectors also carry byte-level provenance hashes.
vdisk/testdata/vectors/** -text
# The event sample is compared byte for byte with the producer-generated stream.
cmd/filedo/testdata/events/*.jsonl -text
# The Explorer icons (MenuIcons.vb) are compared pixel by pixel by the shell's self-test.
assets/menu-icons/*.ico binary
# The vendored web kit is served byte for byte and held to the catalog's SHA-256 (PAGE-STYLE section 0 step 1:
# a line-ending conversion would change what the site serves). The help generator copies it beside the in-app help
# pages (HelpPages.CopyKit) and packaging/check-help.ps1 compares the two files, so both are never converted.
docs/kit/sza-kit.css -text
docs/help/sza-kit.css -text
# The Store listing builder proves itself on this committed export (BOM, CRLF between records, LF inside
# cells, no final newline) by a byte-identical round trip (WINDOWS-STORE rule 13; msix/test-store-tools.ps1),
# so git never normalises its line endings.
msix/testdata/listingData.fixture.csv -text
